{
  "name": "securevault",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "test:frontend": "cd frontend && npx vitest run --reporter=verbose",
    "test:backend": "cd backend && npx jest --testPathPattern=backend.test.js --forceExit --verbose",
    "test:devops": "npx jest tests/devops/devops.offline.test.js --forceExit --verbose",
    "test:integration": "cd backend && npx jest --testPathPattern=integration.offline.test.js --forceExit --verbose --testTimeout=30000",
    "test:all": "npm run test:frontend && npm run test:backend && npm run test:devops && npm run test:integration"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "mongodb": "^7.1.0"
  },
  "devDependencies": {
    "dockerode": "^4.0.10",
    "form-data": "^4.0.5",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.1",
    "node-fetch": "^2.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
