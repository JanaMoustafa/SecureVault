# ============================================================
# SecureVault Environment Configuration
# Copy to .env and fill in real values — NEVER commit .env
# ============================================================

# --- Application ---
NODE_ENV=development

# --- MongoDB ---
MONGO_ROOT_USER=securevault_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# --- JWT ---
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX_STRING_HERE
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Storage ---
MAX_FILE_SIZE=104857600   # 100 MB in bytes

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
